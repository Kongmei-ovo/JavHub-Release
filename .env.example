# Change all placeholder secrets before exposing the service.
POSTGRES_PASSWORD=change-me
DB_PASSWORD=change-me
JAVHUB_DB_PASSWORD=change-me
SUPPLEMENT_ADMIN_TOKEN=change-me

# Obtain this instance-bound code from the publisher after the first startup.
JAVHUB_LICENSE_KEY=
JAVHUB_LICENSE_REFRESH_SECONDS=3600

JAVHUB_PORT=3000
TZ=Asia/Shanghai

# Optional integrations
OPENLIST_USERNAME=
OPENLIST_PASSWORD=
EMBY_API_URL=
EMBY_API_KEY=
TELEGRAM_BOT_TOKEN=
JAVHUB_AVDB_API_KEY=
